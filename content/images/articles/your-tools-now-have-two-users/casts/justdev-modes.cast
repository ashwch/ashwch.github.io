[0.023, "o", "\u001b[38;5;238m─────┬──────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.003, "o", "\u001b[38;5;238m  74\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m First principles for DB readiness in Docker:\u001b[0m\r\n\u001b[38;5;238m  75\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m - the app connects to Postgres over TCP (`db:5432`), not over the local\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  76\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m   Unix socket inside the DB container\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  77\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m - during a fresh volume restore, Postgres can look \"ready\" on the local\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  78\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m   socket before the full `/docker-entrypoint-initdb.d/` sequence is done\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  79\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m - if app startup begins in that window, Django can crash with\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  80\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m   \"connection refused\" while the SQL dump is still being applied\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  81\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  82\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m So this healthcheck proves two things before app/rq may start:\u001b[0m\r\n\u001b[38;5;238m  83\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m   1) Postgres accepts TCP connections on 127.0.0.1:5432\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  84\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m   2) the seed/init sequence has completed\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  85\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\r\n\u001b[38;5;238m  86\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m Why the sentinel is auto-created when missing:\u001b[0m\r\n"]
[0.001, "o", "\u001b[38;5;238m  87\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m - older existing DB volumes predate this marker\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  88\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m - we do NOT want those volumes permanently stuck as unhealthy\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  89\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m - once TCP is healthy on an existing volume, creating the marker is safe\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  90\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;98;114;164m#\u001b[0m\u001b[38;2;98;114;164m   because that volume has already finished init in some earlier run\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  91\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;255;121;198mtest\u001b[0m\u001b[38;2;248;248;242m:\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  92\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m        \u001b[0m\u001b[38;2;248;248;242m-\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;241;250;140mCMD-SHELL\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  93\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m        \u001b[0m\u001b[38;2;248;248;242m-\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;255;121;198m>\u001b[0m\u001b[38;2;255;121;198m-\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  94\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;241;250;140m          pg_isready -h 127.0.0.1 -p 5432 -d $${POSTGRES_DB} -U $${POSTGRES_USER}\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  95\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;241;250;140m          && { test -f /var/lib/postgresql/data/.db-seed-complete\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  96\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;241;250;140m          || touch /var/lib/postgresql/data/.db-seed-complete; }\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  97\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;255;121;198minterval\u001b[0m\u001b[38;2;248;248;242m:\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;241;250;140m30s\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  98\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;255;121;198mtimeout\u001b[0m\u001b[38;2;248;248;242m:\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;241;250;140m60s\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m  99\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;255;121;198mretries\u001b[0m\u001b[38;2;248;248;242m:\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;189;147;249m5\u001b[0m\r\n"]
[0.0, "o", "\u001b[38;5;238m 100\u001b[0m \u001b[38;5;238m│\u001b[0m \u001b[38;2;248;248;242m      \u001b[0m\u001b[38;2;255;121;198mstart_period\u001b[0m\u001b[38;2;248;248;242m:\u001b[0m\u001b[38;2;248;248;242m \u001b[0m\u001b[38;2;241;250;140m80s\u001b[0m\r\n\u001b[38;5;238m─────┴──────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
