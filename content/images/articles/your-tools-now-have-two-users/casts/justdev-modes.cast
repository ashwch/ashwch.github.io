[0.44, "o", "\r\n"]
[0.05, "o", "  just dev mode=tmux                  force tmux panes\r\n  just dev mode=headless              force background mode\r\n"]
[0.0, "o", "  just dev docker-status              show docker-only status for selected worktree\r\n  just dev docker-up                  start backend + frontends in Docker for selected worktree\r\n  just dev docker-up service=diversio-frontend  start only the Diversio frontend in Docker\r\n  just dev docker-up service=optimo-frontend    start only the Optimo frontend in Docker\r\n"]
[0.0, "o", "  just dev docker-up mode=serial          start frontends one at a time in Docker\r\n  just dev docker-down                stop backend + frontends in Docker for selected worktree\r\n  just dev docker-logs service=all    tail docker logs (service=backend/rq/db/redis/nginx/diversio-frontend/optimo-frontend)\r\n  just dev docker-space               show Docker disk usage (images/volumes/cache)\r\n"]
[3.014, "o", "\u001b[2m# Docker mode (Feb 27-28, #47 and #50) put the stack in Compose. Not started here: it builds\u001b[0m\r\n"]
[1.218, "o", "\u001b[2m# a backend image, too much for this laptop's free disk. These are the real files it ran.\u001b[0m\r\n"]
