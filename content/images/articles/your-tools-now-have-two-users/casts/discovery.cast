[0.446, "o", "\r\n"]
[0.021, "o", "This worktree's database: created yet, and which dump its first Backend start loads (starting is\r\nblocked until that is chosen). Also replaces a broken database: --reset with a new dump\r\n\r\nUsage: dev-center database [OPTIONS]\r\n\r\nOptions:\r\n      --sql <PATH>              Load this dump on the first start: .sql, .sql.gz, .dump (binary,\r\n                                restored in parallel), or an encrypted .dump.age or .zip (decrypted\r\n                                next to itself first, with the password from 1Password)\r\n  -w, --worktree <PATH>         Worktree to act on. Default: the monolith worktree containing the\r\n"]
[0.0, "o", "                                current directory (submodules included)\r\n"]
[0.001, "o", "      --controller-root <PATH>  The monolith checkout whose manifest and worktrees the app manages\r\n      --shared                  List the shared dumps (the monolith's [dumps.shared] sandbox); needs\r\n                                a signed-in `cs`\r\n      --json                    Print machine-readable JSON instead of text\r\n      --shared-dump <NAME>      Download a shared dump (unless it is on this machine), decrypt it\r\n"]
[2.509, "o", "\u001b[1;32m$\u001b[0m "]
