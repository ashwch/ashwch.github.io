[0.016, "o", "## 0. How to use this manual\r\n## 1. What this tool is for\r\n## 2. Mental model\r\n## 3. Command map\r\n"]
[0.0, "o", "## 4. Services, profiles and consoles\r\n## 5. URLs, ports and wiring\r\n## 6. Files\r\n## 7. JSON contracts\r\n## 8. Playbooks\r\n"]
