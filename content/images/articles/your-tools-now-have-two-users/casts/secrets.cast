[0.01, "o", "\r\nop_arguments=()\r\nif [[ \"$shared_only\" == false && -f \"$personal_references\" ]]; then\r\n  op_arguments+=(--env-file=\"$personal_references\")\r\nfi\r\nop_arguments+=(--env-file=\"$shared_references\")\r\nif [[ -f \"$override_references\" ]]; then\r\n  validate_override_references\r\n  op_arguments+=(--env-file=\"$override_references\")\r\nfi\r\n\r\n"]
[0.0, "o", "export DIVERSIO_LOCAL_SECRETS_LOADED=1\r\ncd \"$backend_root\"\r\nexec op run \"${op_arguments[@]}\" -- \"$@\"\r\n"]
