[0.002, "o", "# Diversio monolith local dev runner config\r\n# Generated by scripts/dev-config.sh\r\n# Available env vars in commands: BACKEND_PORT, DIVERSIO_FRONTEND_PORT, OPTIMO_FRONTEND_PORT\r\nDIVERSIO_MONOLITH_DEV_SHELL=/bin/bash\r\nDIVERSIO_MONOLITH_BACKEND_DEV_DIR=backend\r\nDIVERSIO_MONOLITH_DIVERSIO_FRONTEND_DEV_DIR=frontend\r\nDIVERSIO_MONOLITH_OPTIMO_FRONTEND_DEV_DIR=optimo-frontend\r\nDIVERSIO_MONOLITH_RQ_DEV_DIR=backend\r\nDIVERSIO_MONOLITH_BACKEND_DEV_CMD=python\\ manage.py\\ runserver\\ \\\"\\$BACKEND_PORT\\\"\r\nDIVERSIO_MONOLITH_DIVERSIO_FRONTEND_DEV_CMD=pnpm\\ start\r\nDIVERSIO_MONOLITH_OPTIMO_FRONTEND_DEV_CMD=pnpm\\ run\\ dev\r\nDIVERSIO_MONOLITH_RQ_DEV_CMD=python\\ manage.py\\ rqworker\\ default\\ --with-scheduler\r\nDIVERSIO_MONOLITH_DIVERSIO_FRONTEND_ENABLED=1\r\nDIVERSIO_MONOLITH_OPTIMO_FRONTEND_ENABLED=0\r\nDIVERSIO_MONOLITH_BACKEND_AUTO_UV=1\r\nDIVERSIO_MONOLITH_RQ_AUTO_UV=1\r\n"]
