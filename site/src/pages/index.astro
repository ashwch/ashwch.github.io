---
/**
 * Homepage.
 *
 * LAYOUT STRATEGY
 *
 * The page has three clear zones, top to bottom:
 *
 *   1. Hero        — rotating photography background with readable glass copy.
 *
 *   2. Writing     — latest six articles as cards.
 *
 *   3. Projects    — all actively maintained projects.
 *                    Broader lifetime work lives on /pages/projects.html.
 *
 * WHY NO PHOTOGRAPHY STRIP
 *
 * We removed the separate "Photography · Gallery" section below the fold.
 * The hero gallery already links directly to /pages/photography.html and
 * carries more emotional weight than three small Unsplash cards ever could.
 * Removing the duplicate strip makes the page cleaner and respects the photos.
 */

import ArticleCard from '../components/ArticleCard.astro';
import HomepageHeroGallery from '../components/HomepageHeroGallery.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepageBanners } from '../data/homepageBanners';
import { projects } from '../data/projects';
import { getAllArticles } from '../lib/content';
import { getHomepagePhotos } from '../lib/photography';

const articles = await getAllArticles();
const latestArticles = articles.slice(0, 6);
const homepagePhotos = getHomepagePhotos();
const rotatingBanners = [
  ...homepageBanners,
  ...homepagePhotos.map((photo) => ({
    slug: `unsplash-${photo.id}`,
    title: photo.title,
    desktopSrc: photo.urls.regular,
    mobileSrc: photo.urls.regular,
    desktopPosition: 'center center',
    mobilePosition: 'center center',
  })),
];
---

<BaseLayout canonical="https://ashwch.com/">
  <section class="hero hero-home">
    <div class="container">
      <div class="hero-home__stage">
        <div class="hero-home__visual">
          <HomepageHeroGallery banners={rotatingBanners} />
        </div>
        <div class="hero-home__copy">
          <span class="eyebrow">Ashwini Chaudhary (Monty)</span>
          <h1 class="display-title">Software, writing, and photography.</h1>
          <p class="hero-copy">
            I lead engineering teams, build software, and write about the systems and tools behind the work.
          </p>
          <div class="hero-actions">
            <a class="button" href="/writing.html">Writing</a>
            <a class="button--secondary" href="/pages/projects.html">Projects</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section home-showcase home-writing">
    <div class="container">
      <div class="section-header home-section-header">
        <div>
          <h2 class="section-title">Writing</h2>
          <p>Engineering practice, systems, leadership, and the tools changing how we work.</p>
        </div>
        <a class="section-link" href="/writing.html">Read the archive →</a>
      </div>

      <div class="grid grid--three home-card-grid home-writing-grid">
        {latestArticles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </div>
  </section>

  <section class="section home-showcase home-projects">
    <div class="container">
      <div class="section-header home-section-header">
        <div>
          <h2 class="section-title">Projects</h2>
          <p>Products, developer tools, and open-source infrastructure from years of making software.</p>
        </div>
        <a class="section-link" href="/pages/projects.html">Explore the full portfolio →</a>
      </div>

      <div class="grid grid--three home-card-grid home-project-grid">
        {projects.map((project) => (
          <article class:list={['project-card', 'home-project-card', project.featured && 'home-project-card--featured']}>
            <div class="home-project-card__body">
              <div class="home-project-card__meta">
                <span class="eyebrow">{project.category}</span>
                {project.featured && <span class="home-project-card__status">Featured</span>}
              </div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <div class="pill-row">
                {project.tags.map((tag) => (
                  <span class="pill">{tag}</span>
                ))}
              </div>
              <div class="hero-actions">
                <a class="button" href={project.href} target="_blank" rel="noreferrer">
                  {project.repo === project.href ? 'View source' : 'Visit site'}
                </a>
                {project.repo && project.repo !== project.href && (
                  <a class="button--secondary" href={project.repo} target="_blank" rel="noreferrer">
                    Source
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
