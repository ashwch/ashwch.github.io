---
import { render } from 'astro:content';
import AbbreviationTooltips from '../components/AbbreviationTooltips.astro';
import ArticleMedia from '../components/ArticleMedia.astro';
import AuthorBio from '../components/AuthorBio.astro';
import Comments from '../components/Comments.astro';
import RichTitle from '../components/RichTitle.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homepageBanners } from '../data/homepageBanners';
import {
  formatDate,
  getAllArticles,
  getReadingStats,
  getRelatedArticles,
  getTagPath,
} from '../lib/content';
import { getWidePoolPhotos, poolPhotoUrl } from '../lib/photoPool';

export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article, articles },
  }));
}

const { article, articles } = Astro.props;
const { Content, headings } = await render(article);
const reading = getReadingStats(article.body ?? '');
const related = getRelatedArticles(article, articles);
const topLevelHeadings = headings.filter((heading) => heading.depth === 2);
const tocHeadings = topLevelHeadings.length >= 2 ? topLevelHeadings : headings.filter((heading) => heading.depth <= 3);
const hasToc = tocHeadings.length >= 2;
// Section numbers in the contents list only line up when it lists the h2 headings.
const tocIsNumbered = topLevelHeadings.length >= 2;

/*
 * Cover and closing photos.
 *
 * Every article opens and closes with one of my photographs, so the writing
 * and the photography sit on the same page. The photos come from every wide
 * photo in the pool (lib/photoPool.ts) and are picked from the article's slug:
 * a given article keeps its photos, and different articles get different ones.
 * They load as ordinary images: the cover is the first thing on the page, so
 * it should appear as fast as possible, with no effect in front of it.
 */
const articlePhotos = [
  ...homepageBanners.map((banner) => ({
    title: banner.title,
    src: banner.desktopSrc,
    position: banner.desktopPosition,
  })),
  ...getWidePoolPhotos().map((photo) => ({
    title: photo.title,
    src: poolPhotoUrl(photo, 'w=1600&h=720&fit=crop&crop=entropy&q=72&auto=format'),
    position: 'center center',
  })),
];
// A string hash (not a plain character sum) so similar slugs land far apart in the list.
const slugNumber = article.data.slug
  .split('')
  .reduce((hash, character) => (Math.imul(hash, 31) + character.charCodeAt(0)) >>> 0, 7);
const coverPhoto = articlePhotos[slugNumber % articlePhotos.length];
const closingPhoto = articlePhotos[(slugNumber + Math.floor(articlePhotos.length / 2)) % articlePhotos.length];
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  canonical={article.data.canonicalUrl}
  type="article"
>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <div class="reading-container">
    <div class="article-page reading-surface">
      <figure class="article-cover">
        <div class="article-cover__frame">
          <img
            src={coverPhoto.src}
            alt=""
            fetchpriority="high"
            decoding="async"
            style={`object-position: ${coverPhoto.position}`}
          />
        </div>
        <figcaption class="article-cover__caption">
          <span>{coverPhoto.title ? `Photo: ${coverPhoto.title}` : 'Photo from my Unsplash portfolio'}</span>
          <a href="/pages/photography.html">More photography →</a>
        </figcaption>
      </figure>

    <div class:list={['article-shell', !hasToc && 'article-shell--no-toc']}>
      {hasToc && (
        <aside class:list={['article-toc', tocIsNumbered && 'article-toc--numbered']} aria-label="Table of contents">
          <div class="eyebrow" style="margin-bottom:0.75rem">Contents</div>
          <nav>
            {tocHeadings.map((heading, index) => (
              <a href={`#${heading.slug}`} data-active={index === 0 ? 'true' : undefined}
                >{heading.text.replace(/\s*#$/, '')}</a
              >
            ))}
          </nav>
        </aside>
      )}

      <article class="article-main">
        <header class="article-header">
          <p class="article-kicker">
            <span>// {article.data.categories[0] ?? article.data.domain}</span>
            <span>{formatDate(article.data.date)}</span>
            <span>{reading.minutes} min read</span>
            <span>{reading.words.toLocaleString('en-CA')} words</span>
          </p>
          <h1 class="article-title">
            <RichTitle title={article.data.title} titleHtml={article.data.titleHtml} />
          </h1>
          {article.data.summary && <p class="article-summary">{article.data.summary}</p>}
        </header>

        <div class="prose">
          <Content />
        </div>

        {article.data.tags.length > 0 && (
          <div class="pill-row" style="width:min(100%, var(--reading-width)); margin-top:2rem">
            {article.data.tags.map((tag) => (
              <a class="pill" href={getTagPath(tag)}>{tag}</a>
            ))}
          </div>
        )}

        <a class="article-closing" href="/pages/photography.html">
          <span class="article-closing__frame">
            <img src={closingPhoto.src} alt="" loading="lazy" decoding="async" style={`object-position: ${closingPhoto.position}`} />
          </span>
          <span class="article-closing__copy">
            <strong>Thanks for reading.</strong>
            <span>When I'm not writing software, I'm usually out with a camera. See the photographs →</span>
          </span>
        </a>

        <AuthorBio />
        <Comments
          identifier={article.data.legacyUrl}
          title={article.data.title}
          url={article.data.canonicalUrl}
        />
      </article>

      <AbbreviationTooltips />
      <ArticleMedia />
    </div>
    </div>
  </div>


  {related.length > 0 && (
    <section class="related-section">
      <div class="container">
        <h2 class="section-title" style="font-size:2.2rem">Related articles</h2>
        <div class="related-grid">
          {related.map((candidate) => (
            <article class="article-card">
              <div class="article-card__meta">
                <span class="eyebrow" style="margin:0">{candidate.data.domain}</span>
              </div>
              <h3>
                <a class="article-list__title" href={candidate.data.legacyUrl}
                  ><RichTitle title={candidate.data.title} titleHtml={candidate.data.titleHtml} /></a
                >
              </h3>
              <p>{candidate.data.summary ?? candidate.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    // Reading progress: a thin bar under the header that fills as the article is read.
    const readingProgressBar = document.querySelector<HTMLElement>('[data-reading-progress]');
    const articleBody = document.querySelector<HTMLElement>('.article-main');
    if (readingProgressBar && articleBody) {
      let isProgressUpdateQueued = false;
      const updateReadingProgress = () => {
        isProgressUpdateQueued = false;
        const bounds = articleBody.getBoundingClientRect();
        const readable = bounds.height - window.innerHeight;
        const progress = readable > 0 ? Math.min(Math.max(-bounds.top / readable, 0), 1) : 1;
        readingProgressBar.style.transform = `scaleX(${progress})`;
      };
      const queueReadingProgress = () => {
        if (isProgressUpdateQueued) return;
        isProgressUpdateQueued = true;
        requestAnimationFrame(updateReadingProgress);
      };
      window.addEventListener('scroll', queueReadingProgress, { passive: true });
      window.addEventListener('resize', queueReadingProgress);
      updateReadingProgress();
    }

    const articleTableOfContents = document.querySelector<HTMLElement>('.article-toc');
    const tableOfContentsNavigation = articleTableOfContents?.querySelector<HTMLElement>('nav');

    if (articleTableOfContents && tableOfContentsNavigation) {
      const headingEntries: Array<{ link: HTMLAnchorElement; heading: HTMLElement }> = [];

      for (const link of articleTableOfContents.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
        const headingId = link.getAttribute('href')?.slice(1);
        const heading = headingId ? document.getElementById(headingId) : null;
        if (heading) headingEntries.push({ link, heading });
      }

      let activeHeadingLink: HTMLAnchorElement | undefined;

      const updateActiveHeadingLink = () => {
        if (headingEntries.length === 0 || articleTableOfContents.offsetParent === null) return;

        const stickyTop = Number.parseFloat(getComputedStyle(articleTableOfContents).top) || 0;
        const rootFontSize = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        const headingOffset = stickyTop + rootFontSize + 1; // Allow for subpixel anchor positions.
        let activeHeadingEntry = headingEntries[0];

        for (const headingEntry of headingEntries) {
          const headingBounds = headingEntry.heading.getBoundingClientRect();
          if (headingBounds.top >= headingOffset) {
            if (headingBounds.bottom <= window.innerHeight) activeHeadingEntry = headingEntry;
            break;
          }
          activeHeadingEntry = headingEntry;
          if (headingBounds.bottom > headingOffset) break;
        }

        const pageBottomReached =
          window.scrollY > 0 &&
          Math.ceil(window.scrollY + window.innerHeight) >= document.documentElement.scrollHeight - 2;
        if (pageBottomReached) activeHeadingEntry = headingEntries[headingEntries.length - 1];

        if (activeHeadingLink !== activeHeadingEntry.link) {
          for (const headingEntry of headingEntries) {
            const isActive = headingEntry === activeHeadingEntry;
            if (isActive) {
              headingEntry.link.dataset.active = 'true';
              headingEntry.link.setAttribute('aria-current', 'location');
            } else {
              delete headingEntry.link.dataset.active;
              headingEntry.link.removeAttribute('aria-current');
            }
          }
          activeHeadingLink = activeHeadingEntry.link;
        }

        const navigationBounds = tableOfContentsNavigation.getBoundingClientRect();
        const activeLinkBounds = activeHeadingEntry.link.getBoundingClientRect();

        if (activeLinkBounds.top < navigationBounds.top) {
          tableOfContentsNavigation.scrollTop -= navigationBounds.top - activeLinkBounds.top;
        } else if (activeLinkBounds.bottom > navigationBounds.bottom) {
          tableOfContentsNavigation.scrollTop += activeLinkBounds.bottom - navigationBounds.bottom;
        }
      };

      window.addEventListener('scroll', updateActiveHeadingLink, { passive: true });
      window.addEventListener('resize', updateActiveHeadingLink);
      window.addEventListener('hashchange', updateActiveHeadingLink);
      updateActiveHeadingLink();
    }
  </script>
</BaseLayout>
