---
/**
 * Page photo band.
 *
 * One photograph, in full colour, spans the top of the page and fades into
 * the page background. Every ~10 seconds it crossfades to another photo.
 *
 * WHY A BAND AND NOT A WALL
 *
 *   The previous version tiled photos behind the whole page. To keep text
 *   readable it had to desaturate the photos and cover them with a tinted
 *   veil, which made both the photos and the page look dull. A single band
 *   at the top shows one photo properly and leaves the reading area calm.
 *
 * HOW IT WORKS
 *
 *   The page ships a short list of photos; the script then adds every wide
 *   photo from /photo-pool.json, so the band is not limited to that list.
 *
 *   Two frames are stacked. The server renders the first photo, chosen from
 *   the page path so different pages open on different photos. The script
 *   loads the next photo into the hidden frame, waits for it to decode, and
 *   swaps the is-active class; CSS does the crossfade.
 *
 *   Rotation stops for prefers-reduced-motion and while the tab is hidden.
 */
type BackdropPhoto = {
  src: string;
  position?: string;
};

interface Props {
  photos: BackdropPhoto[];
}

const { photos } = Astro.props;
const pathHash = Astro.url.pathname.split('').reduce((sum, char) => sum + char.charCodeAt(0), 0);
const startIndex = photos.length ? pathHash % photos.length : 0;
const firstPhoto = photos[startIndex];
---

{firstPhoto && (
  <div class="site-photo-backdrop" aria-hidden="true" data-photo-backdrop>
    <div class="site-photo-backdrop__frame is-active" data-backdrop-frame>
      <img
        src={firstPhoto.src}
        alt=""
        fetchpriority="high"
        decoding="async"
        style={`object-position: ${firstPhoto.position ?? 'center center'}`}
      />
    </div>
    <div class="site-photo-backdrop__frame" data-backdrop-frame>
      <img alt="" decoding="async" />
    </div>
    <div class="site-photo-backdrop__fade"></div>
  </div>
)}

<script is:inline define:vars={{ photos, startIndex }}>
  (() => {
    const backdrop = document.querySelector('[data-photo-backdrop]');
    if (!(backdrop instanceof HTMLElement) || !Array.isArray(photos) || photos.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const frames = Array.from(backdrop.querySelectorAll('[data-backdrop-frame]'));
    if (frames.length < 2) return;

    // Start from the server-rendered photo, then go through the rest in random order.
    const rest = photos.filter((_, index) => index !== startIndex);
    for (let index = rest.length - 1; index > 0; index -= 1) {
      const swapIndex = Math.floor(Math.random() * (index + 1));
      [rest[index], rest[swapIndex]] = [rest[swapIndex], rest[index]];
    }
    const sequence = [photos[startIndex], ...rest];

    // Once the page has loaded, add every wide photo from the pool in random order.
    fetch('/photo-pool.json')
      .then((response) => (response.ok ? response.json() : []))
      .then((entries) => {
        if (!Array.isArray(entries)) return;
        const poolPhotos = entries
          .filter(([, , isWide]) => isWide)
          .map(([path]) => ({
            src: `https://images.unsplash.com/${path}?w=1920&h=760&fit=crop&crop=entropy&q=75&auto=format`,
            position: 'center center',
          }));
        for (let index = poolPhotos.length - 1; index > 0; index -= 1) {
          const swapIndex = Math.floor(Math.random() * (index + 1));
          [poolPhotos[index], poolPhotos[swapIndex]] = [poolPhotos[swapIndex], poolPhotos[index]];
        }
        sequence.push(...poolPhotos);
      })
      .catch(() => {
        // Offline or blocked: keep rotating through the photos the page came with.
      });

    let sequenceIndex = 0;
    let activeFrameIndex = 0;
    let intervalId;

    const showNextPhoto = () => {
      const nextIndex = (sequenceIndex + 1) % sequence.length;
      const photo = sequence[nextIndex];
      const hiddenFrame = frames[activeFrameIndex === 0 ? 1 : 0];
      const visibleFrame = frames[activeFrameIndex];
      const image = hiddenFrame.querySelector('img');
      if (!(image instanceof HTMLImageElement)) return;

      // Swap only after the next photo has loaded, so the fade never shows a blank frame.
      const loader = new Image();
      loader.onload = () => {
        image.src = photo.src;
        image.style.objectPosition = photo.position || 'center center';
        hiddenFrame.classList.add('is-active');
        visibleFrame.classList.remove('is-active');
        activeFrameIndex = activeFrameIndex === 0 ? 1 : 0;
        sequenceIndex = nextIndex;
      };
      loader.onerror = () => {
        sequenceIndex = nextIndex;
      };
      loader.src = photo.src;
    };

    const stopRotation = () => {
      if (!intervalId) return;
      window.clearInterval(intervalId);
      intervalId = undefined;
    };

    const startRotation = () => {
      stopRotation();
      intervalId = window.setInterval(showNextPhoto, 10000);
    };

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopRotation();
      else startRotation();
    });

    startRotation();
  })();
</script>
