---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SitePhotoBackdrop from '../components/SitePhotoBackdrop.astro';
import '../styles/global.css';
import { homepageBanners } from '../data/homepageBanners';
import { siteMeta } from '../data/site';
import { getLandscapePhotos } from '../data/curatedPhotos';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
}

const {
  title,
  description = siteMeta.description,
  canonical = Astro.url.href,
  image,
  type = 'website',
  robots = 'index,follow',
} = Astro.props;

const pageTitle = title ? `${title} · ${siteMeta.name}` : `${siteMeta.title} · ${siteMeta.tagline}`;
const ogImage = image ? new URL(image, Astro.site ?? siteMeta.siteUrl).toString() : undefined;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || undefined;
// The photo band shows on listing and standalone pages. Articles stay plain for
// reading, the photography page is already all photos, and the homepage has its
// own photo hero.
const showPhotoBackdrop =
  type !== 'article' &&
  Astro.url.pathname !== '/' &&
  !/^\/pages\/photography(?:\.html|\/)?$/.test(Astro.url.pathname);
const backdropPhotos = [
  ...homepageBanners.map((banner) => ({
    src: banner.desktopSrc,
    position: banner.desktopPosition,
  })),
  ...getLandscapePhotos().map((photo) => ({
    // Unsplash crops and resizes on request; a wide crop suits the band.
    src: `${photo.urls.raw}&w=1920&h=760&fit=crop&crop=entropy&q=75&auto=format`,
    position: 'center center',
  })),
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteMeta.author} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" title="ashwch Atom feed" href="/feeds/all.atom.xml" />
    <link rel="alternate" type="application/rss+xml" title="ashwch RSS feed" href="/rss.xml" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@suicide_chewie" />
    <meta name="twitter:creator" content="@suicide_chewie" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script is:inline>
      const savedTheme = localStorage.getItem('ashwch-theme');
      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = savedTheme || (systemPrefersDark ? 'dark' : 'light');
    </script>
    {gaMeasurementId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
        <script is:inline define:vars={{ gaMeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaMeasurementId);
        </script>
      </>
    )}
  </head>
  <body>
    <div class:list={['site-shell', showPhotoBackdrop && 'site-shell--photo-backdrop']}>
      <SiteHeader />
      <main class="site-main">
        <slot />
      </main>
      <SiteFooter />
    </div>
    {showPhotoBackdrop && <SitePhotoBackdrop photos={backdropPhotos} />}
  </body>
</html>
